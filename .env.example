# Browser-safe values. These are visible in the built frontend.
PUBLIC_SUPABASE_URL=https://jwmpjbpaivzkwatwagqo.supabase.co
PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-publishable-or-anon-key

# Server/CI-only values. Never use these in React code or PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
SUPABASE_ACCESS_TOKEN=replace-with-your-supabase-cli-access-token

# Optional authentication providers, used only by server-side functions.
TWILIO_ACCOUNT_SID=replace-if-sms-is-enabled
TWILIO_AUTH_TOKEN=replace-if-sms-is-enabled
TWILIO_VERIFY_SERVICE_SID=replace-if-sms-is-enabled